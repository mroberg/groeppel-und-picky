---
import '@fontsource/andika/400.css';
import '@fontsource/andika/700.css';
import '@fontsource/gluten/500.css';
import '@fontsource/gluten/700.css';
import '@fontsource/gluten/800.css';
import '../styles/global.css';
import Social from '../components/Social.astro';

interface Props { title?: string; description?: string; image?: string; noindex?: boolean; jsonld?: object | object[]; ogType?: string }
const {
  title,
  description = 'Gröppel und Picky: Zeitreiseabenteuer für Kinder ab 6. Bücher, Hörbuch, Ausmalbilder und Geheimnisse.',
  image = '/img/og/start.jpg',
  noindex = false,
  jsonld,
  ogType = 'website',
} = Astro.props;
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const fullTitle = title ? (title.includes('Gröppel') ? title : `${title} · Gröppel und Picky`) : 'Gröppel und Picky · Zeitreise-Kinderbuch und Hörbuch ab 6';
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: "Los geht's" },
  { href: '/abenteuer/', label: 'Abenteuer' },
  { href: '/figuren/', label: 'Figuren' },
  { href: '/mitmachen/', label: 'Mitmachen' },
  { href: '/ueber-uns/', label: 'Über uns' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#fffcf3">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex, follow"> : <link rel="canonical" href={new URL(path, Astro.site)}>}
  <link rel="icon" href="/img/favicon-48.png" type="image/png" sizes="48x48">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="sitemap" href="/sitemap.xml">
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content="Gröppel und Picky">
  <meta property="og:url" content={new URL(path, Astro.site)}>
  <meta property="og:locale" content="de_DE">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(image, Astro.site)}>
  {image.endsWith('.jpg') && <><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"></>}
  <meta name="twitter:card" content="summary_large_image">
  {ld.map(d => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...d })} />)}
</head>
<body>
  <a class="skip" href="#inhalt">Zum Inhalt springen</a>
  <header class="top">
    <div class="wrap">
      <a class="brand" href="/"><img src="/img/logo.webp" alt="" width="52" height="44">Gröppel&nbsp;und&nbsp;Picky</a>
      <nav class="main" aria-label="Hauptmenü">
        {nav.map(n => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </div>
  </header>
  <main id="inhalt">
    <slot />
  </main>
  <footer>
    <div class="wrap">
      <span>© {new Date().getFullYear()} Gröppel und Picky</span>
      <nav aria-label="Rechtliches"><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a></nav>
      <Social />
    </div>
  </footer>
</body>
</html>
