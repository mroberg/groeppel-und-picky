---
import Base from '../layouts/Base.astro';
import { ausmalbilder } from '../data/site';
---
<Base title="Mitmachen" description="Kostenlose Ausmalbilder von Gröppel und Picky zum Ausdrucken.">
  <div class="page-head"><div class="wrap stack" style="gap:8px"><span class="eyebrow">Mitmachen</span><h1>Schnapp dir deine Buntstifte</h1><p>Lade dir ein Bild herunter, druck es aus und mal Gröppel und Picky so, wie du willst.</p></div></div>
  <section class="band" style="padding-top:24px">
    <div class="wrap downloads">
      {ausmalbilder.map(a => (
        <a class="dl sketch" href={`/ausmalbilder/${a.datei}`} download>
          <img src={`/img/${a.vorschau}`} alt={`Vorschau: ${a.titel}`} width="500" height="354" loading="lazy" />
          <span class="dl-title">{a.titel}</span>
          <span class="btn">PDF herunterladen</span>
          <small>Kostenlos</small>
        </a>
      ))}
    </div>
  </section>
</Base>
<style>
  .downloads { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px }
  .dl { display: grid; gap: 14px; justify-items: start; padding: 24px; background: var(--paper-2); color: inherit; text-decoration: none; transition: transform .2s }
  .dl:hover { transform: rotate(-1deg) translateY(-3px) }
  .dl img { width: 100%; background: #fff; border: 3px solid var(--line); border-radius: 8px }
  .dl-title { font: 700 1.4rem/1.2 var(--display) }
  @media (max-width: 820px) { .downloads { grid-template-columns: 1fr } }
</style>
