---
import Base from '../layouts/Base.astro';
import Team from '../components/Team.astro';
import { ldAutor, ldIllustrator } from '../data/site';
---
<Base title="Autor Matthias Roberg und Illustrator Ludwig Tredup" image="/img/og/ueber-uns.jpg" description="Wer steckt hinter Gröppel und Picky? Autor Matthias Roberg und Illustrator Ludwig Tredup, zwei Freunde aus Schleswig-Holstein." jsonld={[{ ...ldAutor, jobTitle: 'Autor' }, { ...ldIllustrator, jobTitle: 'Illustrator' }]}>
  <div class="page-head"><div class="wrap stack" style="gap:8px"><span class="eyebrow">Wer steckt dahinter?</span><h1>Zwei Freunde aus Schleswig-Holstein</h1></div></div>
  <section class="band" style="padding-top:24px"><div class="wrap"><Team lang /></div></section>
</Base>
