---
import Base from '../../layouts/Base.astro';
import RemindForm from '../../components/RemindForm.astro';
import { band2, ldAutor, ldIllustrator, ldSerie } from '../../data/site';
const ldBuch = { '@type': 'Book', name: band2.titel, author: ldAutor, illustrator: ldIllustrator, isPartOf: ldSerie, position: 2, inLanguage: 'de', genre: 'Kinderbuch', typicalAgeRange: '4-10', image: 'https://groeppel-und-picky.de/img/og/piraten.jpg' };

const leseprobe = [
  "Ein leichter Wind strich über das Meer und trug den salzigen Geschmack des Wassers mit sich. Der Himmel war fast strahlend blau und nur von wenigen Wolken durchzogen. Man konnte mehrere schwarzköpfige Möwen erkennen. Es machte den Eindruck, als würden sie den Wolken elegant ausweichen und kreischend ihre Flugbahn ankündigen. Die Sonne schien auf eine wunderschöne, malerische Bucht mit einem feinen Sandstrand, der sich am Rande einer Felsformation einige hundert Meter lang erstreckte. Das kristallklare Meer war türkisblau gefärbt und lud zum Baden ein.",
  "Direkt am Strand standen überall verteilt Palmen, die sich ins Landesinnere zu einem kleinen Hain fügten. Am Rand des Strandes stand im Schatten der Palmen ein kleines Krokodil. Auf seiner Schulter saß ein blaugefiederter Vogel mit orangem Schnabel. Beide blickten mit weit geöffneten Augen auf das Meer.",
  "Dort draußen, nur wenige hundert Meter vom Strand entfernt, lag ein großes, viermastiges Schiff vor Anker. Die Segel waren eingeholt und nur die schwarze Totenkopffahne wehte im Wind leicht vor sich hin. An Deck war niemand zu sehen, so dass es den Eindruck erweckte, als sei das Schiff verlassen.",
  "„Das ist tatsächlich ein Piratenschiff, Gröppel. So etwas habe ich bei uns noch nie gesehen. Meinst Du, wir sind vielleicht nur am falschen Ort gelandet und wenigstens in der richtigen Zeit?“ fragte der kleine Vogel.",
  "„Also ganz sicher bin ich mir nicht, vielleicht sollten wir uns erstmal umschauen“, sagte Gröppel und ließ seinen Blick über das Meer streifen."
];
---
<Base title={`${band2.titel} · Band 2 erscheint im ${band2.erscheint}`} description={`Band 2 der Kinderbuchreihe: Gröppel und Picky landen 1699 bei den Piraten in Nassau. Erscheint im ${band2.erscheint}. Teaser, Leseprobe und Erinnerung per Mail.`} image="/img/og/piraten.jpg" jsonld={ldBuch}>
  <section class="pirates band">
    <div class="wrap">
      <div class="stack" style="gap:18px">
        <span class="eyebrow">Band 2 · {band2.erscheint}</span>
        <h1 style="font-size:clamp(2.3rem,6vw,4rem)">{band2.titel}</h1>
        <p>Der RaZeTu hat wieder zugeschlagen. Diesmal landen Gröppel und Picky an einem Strand mit Palmen, und draußen in der Bucht liegt ein Schiff mit Totenkopfflagge. Schau dir an, wie das neue Abenteuer beginnt.</p>
        <div class="wave" aria-hidden="true"></div>
        <RemindForm />
      </div>
      <div class="video sketch" id="teaser">
        <video controls preload="none" playsinline hidden src="/media/teaser-band2.mp4"></video>
        <button class="poster" type="button" aria-label="Teaser zu Band 2 abspielen"><span>▶ Film ab!</span></button>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap stack" style="gap:28px">
      <div class="stack" style="gap:8px"><span class="eyebrow">Was schon verraten wird</span><h2>Ahoi, Bahamas!</h2></div>
      <div class="teasers">
        <article class="teaser sketch">
          <span class="big">1699</span>
          <h3>Wohin geht's?</h3>
          <p>Nach Nassau auf der Insel New Providence in der Karibik. Damals war der Hafen eine echte Piratenhochburg. Professor Einfred warnt: Bloß nicht in eine Piraten-Spelunke gehen!</p>
        </article>
        <article class="teaser sketch">
          <span class="big">Anne</span>
          <h3>Eine neue Freundin</h3>
          <p>Kapitänin Anne Bonny hat ihr eigenes kleines Boot. Die anderen Piraten machen sich über sie lustig, aber Gröppel und Picky halten zu ihr.</p>
        </article>
        <article class="teaser sketch">
          <span class="big">?</span>
          <h3>Das Rätsel</h3>
          <p>Anne hat eine Flaschenpost gefunden. Darin steckt eine geheimnisvolle Karte, und die stammt vom berüchtigten Piratenkapitän Henry. Wohin sie wohl führt?</p>
        </article>
      </div>
    </div>
  </section>

  <section class="band" style="background:var(--paper-2)">
    <div class="wrap">
      <article class="leseprobe sketch">
        <span class="eyebrow">Leseprobe</span>
        <h2>Kapitel 1: In der Karibik</h2>
        {leseprobe.map(p => <p>{p}</p>)}
        <p class="more">Wie es weitergeht, erfährst du im {band2.erscheint}.</p>
      </article>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="true-story sketch">
        <img src="/img/schiff.webp" alt="Piratenschiff" loading="lazy" style="border-radius:12px;background:#fff">
        <div class="stack" style="gap:12px">
          <span class="eyebrow">Stimmt es eigentlich?</span>
          <h3 style="font-size:1.9rem">Kapitän Henry gab es wirklich</h3>
          <p>Henry Every war einer der berühmtesten Piraten seiner Zeit. 1695 überfiel er das riesige Schiff „Ganj-i-Sawai“ und erbeutete Gold und Edelsteine. Danach verschwand er spurlos. Wo sein Schatz geblieben ist, weiß bis heute niemand so genau.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .teasers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px }
  .teaser { background: var(--paper-2); padding: 22px; display: grid; gap: 10px; align-content: start }
  .teaser:nth-child(1) { transform: rotate(-1deg) } .teaser:nth-child(3) { transform: rotate(1deg) }
  .teaser .big { font: 800 2.4rem/1 var(--display); color: var(--orange) }
  .leseprobe { max-width: 720px; margin-inline: auto; background: #fff; padding: clamp(24px, 5vw, 48px); display: grid; gap: 16px; font-size: 1.15rem; line-height: 1.75 }
  .leseprobe h2 { font-size: clamp(1.8rem, 4vw, 2.4rem) }
  .leseprobe h2 + p::first-letter { font: 800 3.4em/0.8 var(--display); float: left; margin: 6px 10px 0 0; color: var(--croc) }
  .leseprobe .more { font-weight: 700; color: var(--picky) }
  @media (max-width: 820px) { .teasers { grid-template-columns: 1fr } }
</style>
<script>
  const vbox = document.getElementById('teaser')!;
  vbox.querySelector('.poster')!.addEventListener('click', e => {
    const v = vbox.querySelector('video')!; v.hidden = false; (e.currentTarget as HTMLElement).hidden = true; v.play();
  });
</script>
