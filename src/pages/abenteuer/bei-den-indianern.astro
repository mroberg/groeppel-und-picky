---
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';
import LinkButtons from '../../components/LinkButtons.astro';
import { band1, ldAutor, ldIllustrator, ldSerie } from '../../data/site';
const angebot = (l: { name: string; url: string }) => ({ '@type': 'Offer', url: l.url, seller: { '@type': 'Organization', name: l.name }, availability: 'https://schema.org/InStock' });
const ldBuch = {
  '@type': 'Book', '@id': 'https://groeppel-und-picky.de/abenteuer/bei-den-indianern/#buch',
  name: band1.titel, alternateName: band1.untertitel, author: ldAutor, illustrator: ldIllustrator,
  isPartOf: ldSerie, position: 1, inLanguage: 'de', genre: 'Kinderbuch', typicalAgeRange: '4-10',
  image: 'https://groeppel-und-picky.de/img/buch-band1.webp',
  description: 'Das kleine Krokodil Gröppel und sein bester Freund Picky, ein Krokodilwächter-Vogel, reisen mit der Zeitmaschine RaZeTu ins Amerika des Jahres 1853 und erleben ein Abenteuer bei den Indianern.',
  workExample: [
    { '@type': 'Book', bookFormat: 'https://schema.org/Paperback', isbn: '9783752627657', datePublished: '2020-11-30', publisher: { '@type': 'Organization', name: 'BoD – Books on Demand' }, offers: band1.buch.map(angebot) },
    { '@type': 'Book', bookFormat: 'https://schema.org/EBook', isbn: '9783752638059', offers: band1.ebook.map(angebot) },
    { '@type': 'Audiobook', bookFormat: 'https://schema.org/AudiobookFormat', datePublished: '2026-11-15', offers: band1.hoerbuch.map(angebot) },
  ],
};

const szenen = [
  ['szene-01', 'Zuhause in Afrika'], ['szene-02', 'Aufwachen!'], ['szene-06', 'Der RaZeTu'],
  ['szene-10', 'Gelandet. Aber wo?'], ['szene-14', 'Ein neuer Freund'], ['szene-19', 'AAARRR!'],
  ['szene-22', 'Die Cowboys kommen'], ['szene-24', 'Und jetzt nach Hause?'],
];
// Leseprobe: Anfang von Kapitel 1 aus der Endfassung (Buchseiten 7 bis 12)
const leseprobe = [
  'Über dem kleinen afrikanischen Dorf, das am Rande eines Flusses im Schutz einiger Palmen lag, war die warme Morgensonne aufgegangen. Hier und da hörte man vergnügt die Vögel zwitschern und aus einigen der Holzhütten duftete es herrlich nach frischgebackenem Brot.',
  'Ein kleiner Vogel zog seine Bahn am Himmel und steuerte zielgerichtet auf eine der Hütten zu. Von den vielen Fenstern mit den großen Rahmen standen mindestens die Hälfte offen. Der Vogel setzte zum Landeanflug an, flog durch ein geöffnetes Fenster in die Hütte hinein und landete dort auf der Rückenlehne eines Stuhls. Direkt daneben stand ein Bett, in dem ein kleines Krokodil auf der Seite lag und leise vor sich hinschnarchte, die Decke bis unter das Kinn hochgezogen. Der Vogel legte seinen Kopf schief und guckte mit großen Augen zunächst auf das schlafende Krokodil und danach auf den blauen Wecker, der vor dem Bett lag. Er war offensichtlich vom Tisch heruntergeworfen worden.',
  '„Das kann ja wohl echt nicht wahr sein!“, piepste er dann lauthals ins Zimmer.',
  'Das Krokodil quittierte den Satz mit einem kurzen, lauten Doppel-Schnarcher.',
  '„Gröppel! Steh sofort auf, Du alte Schlafnase.“',
  'Noch immer rührte sich das Krokodil nicht, so dass der Vogel zu ihm hinflog, sich mit seinem Schnabel einen Zipfel der Decke schnappte und diese dann mit einem Satz von ihm herunterzog.',
  'BILD',
  'Aufgeschreckt durch die plötzliche Bewegung rollte Gröppel in seinem Bett herum und fiel mit Schwung zur Seite auf den Boden heraus.',
  '„Autsch! Wie, was, wo, wer?“, sagte er und rieb sich die Stelle, auf der er gelandet war.',
  '„Och Menno, Picky. Wieso machst Du denn so ein Theater am frühen Morgen und wirfst mich aus dem Bett? Ich bin doch kein Bettvorleger.“',
  'Picky, der inzwischen wieder auf der Stuhllehne gelandet war, antwortete mahnend: „Gröppel, Du hast versprochen rechtzeitig aufzustehen und nicht wieder zu verschlafen. Jetzt schau Dir mal Deinen Wecker an, da auf dem Fußboden.“',
  '„Äh. Ja, also …“, begann Gröppel. „Der muss vom Tisch gefallen sein, bestimmt bin ich da in der Nacht aus Versehen gegen gestoßen.“',
  '„Gestern Nacht hat ihn der Wind runtergeweht. Vorgestern Nacht wurde der Wecker von einem Erdbeben - wohlgemerkt nur in Deiner Hütte - heruntergeworfen. Und eine Nacht davor hat es in Deine Hütte reingeregnet, so dass der Tisch durch das viele Wasser verrutscht und der Wecker umgekippt ist“, zählte Picky auf.',
  '„Du solltest Dich wirklich schämen, mir immer solche Märchen aufzutischen. Beeile Dich lieber, sonst kommen wir wieder zu spät zur Schule.“',
];
// TODO: Bewertungen im Originalwortlaut von der alten Seite übernehmen
const bewertungen = [
  { name: 'Paula', text: 'Schon x-mal gelesen. Meine Tochter malt die Figuren nach und wartet auf Teil 2.' },
  { name: 'Marc', text: 'Mit meinem Sohn (5) gelesen. Toll zum Vorlesen und für Erstleser.' },
  { name: 'Miriam', text: 'Mein Sohn (7) liebt das Buch, und die Bilder sind wunderbar.' },
];
---
<Base title={`${band1.titel} · Kinderbuch und Hörbuch ab 6`} description="Band 1: Gröppel und Picky reisen mit der Zeitmaschine ins Amerika des Jahres 1853. Als Buch, E-Book und ab 15.11.2026 als Hörbuch bei Spotify, Audible und Storytel." image="/img/og/band1.jpg" ogType="book" jsonld={ldBuch}>
  <div class="book-hero">
    <div class="wrap">
      <img class="cover" src="/img/buch-band1.webp" alt={`Buchcover ${band1.titel}`} width="340" height="539">
      <div class="stack" style="gap:20px">
        <span class="eyebrow">Band 1 · Buch und Hörbuch</span>
        <h1 style="font-size:clamp(2.3rem,6vw,4rem)">{band1.titel}</h1>
        <p style="font-size:1.2rem">Wie kann das nur sein? Eben gerade noch stand das kleine Krokodil Gröppel mit seinem besten Freund Picky im Labor von Professor Einfred in ihrem Dorf in Afrika. Und nun befinden sie sich plötzlich bei Indianern im weit entfernten Amerika. Sind sie tatsächlich durch die Zeit gereist? Und wie kommen sie wieder nach Hause?</p>
        <div id="hoerprobe" style="scroll-margin-top:96px"><Player note="· ab 15.11. das ganze Hörbuch" style="background:var(--croc);color:#fff" /></div>
        <a class="btn alt" href="#leseprobe" style="width:fit-content">Leseprobe lesen</a>
        <dl class="facts">
          <dt>Alter</dt><dd>{band1.alter}</dd>
          <dt>Text</dt><dd>Matthias Roberg</dd>
          <dt>Bilder</dt><dd>Ludwig Tredup</dd>
          <dt>Erschienen</dt><dd>{band1.erschienen}</dd>
          <dt>ISBN</dt><dd>{band1.isbn}</dd>
        </dl>
      </div>
    </div>
  </div>

  <section class="band" style="padding-top:0;scroll-margin-top:80px" id="kaufen">
    <div class="wrap stack" style="gap:24px">
      <h2>Hier gibt's das Abenteuer</h2>
      <div class="buy">
        <div class="sketch"><h3>Als Buch</h3><p>Gedruckt mit allen Bildern.</p><LinkButtons links={band1.buch} /></div>
        <div class="sketch"><h3>Als E-Book</h3><p>Zum Lesen auf dem Tablet oder E-Reader.</p><LinkButtons links={band1.ebook} variant="alt" /></div>
        <div class="sketch"><img src="/img/cover-hoerbuch.webp" alt="" style="width:96px;border:3px solid var(--line);border-radius:10px"><h3>Als Hörbuch</h3><p>Ab 15.11.2026 zum Streamen.</p><LinkButtons links={band1.hoerbuch} variant="blue" /></div>
      </div>
    </div>
  </section>

  <section class="band" style="background:var(--paper-2)">
    <div class="wrap stack" style="gap:20px">
      <span class="eyebrow">Blick ins Buch</span>
      <h2>Die Reise in Bildern</h2>
      <div class="strip" tabindex="0" aria-label="Bilder aus dem Buch">
        {szenen.map(([img, cap]) => <figure><img src={`/img/${img}.webp`} alt="" loading="lazy" /><figcaption>{cap}</figcaption></figure>)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <article class="leseprobe sketch" id="leseprobe">
        <span class="eyebrow">Leseprobe</span>
        <h2>Kapitel 1: Los geht’s</h2>
        {leseprobe.map(p => p === 'BILD'
          ? <figure class="lp-bild"><img src="/img/szene-02.webp" alt="Picky zieht Gröppel die Bettdecke weg" loading="lazy" /><figcaption>Aufwachen!</figcaption></figure>
          : <p>{p}</p>)}
        <p class="more">Ob die beiden pünktlich zur Schule kommen? Und was hat Professor Einfred damit zu tun? Das erfährst du im Buch oder im Hörbuch.</p>
        <div class="btns"><a class="btn" href="#kaufen">Hier gibt's das Buch</a><a class="btn alt" href="#hoerprobe">Lieber anhören?</a></div>
      </article>
    </div>
  </section>

  <section class="band">
    <div class="wrap stack" style="gap:24px">
      <div class="stack" style="gap:8px"><span class="eyebrow">5 von 5 Sternen</span><h2>Das sagen Familien</h2></div>
      <div class="quotes">
        {bewertungen.map(b => <div class="quote sketch"><span class="stars" aria-label="5 von 5 Sternen">★★★★★</span><p>{b.text}</p><b>{b.name}</b></div>)}
      </div>
    </div>
  </section>

  <section class="band" style="padding-top:0">
    <div class="wrap">
      <div class="true-story sketch">
        <img src="/img/szene-21.webp" alt="Totempfahl unter Sternenhimmel" loading="lazy" style="border-radius:12px">
        <div class="stack" style="gap:12px">
          <span class="eyebrow">Stimmt es eigentlich?</span>
          <h3 style="font-size:1.9rem">Quanah gab es wirklich</h3>
          <p>Das Abenteuer spielt im Jahr 1853 in den Guadalupe Mountains in Texas. Dort lebten damals die Comanche, und die Familie, die Gröppel und Picky kennenlernen, gab es wirklich.</p>
          <ul class="names">
            <li><b>Nocona</b> heißt „Der Wanderer“. Er war Häuptling der Comanche. Die Cowboys nannten ihn Peta Nocona.</li>
            <li><b>Naduah</b> heißt „Die sich bei uns wohlfühlt“. Sie war Noconas Frau und hieß eigentlich Cynthia Ann Parker.</li>
            <li><b>Quanah</b> heißt „Duft“. Er war ihr Sohn, im Buch etwa 9 Jahre alt, und hilft Gröppel und Picky. Die Cowboys nannten ihn Quanah Parker.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .leseprobe { scroll-margin-top: 96px; max-width: 720px; margin-inline: auto; background: #fff; padding: clamp(24px, 5vw, 48px); display: grid; gap: 16px; font-size: 1.15rem; line-height: 1.75 }
  .leseprobe h2 { font-size: clamp(1.8rem, 4vw, 2.4rem) }
  .leseprobe h2 + p::first-letter { font: 800 3.4em/0.8 var(--display); float: left; margin: 6px 10px 0 0; color: var(--croc) }
  .leseprobe .more { font-weight: 700; color: var(--picky) }
  .lp-bild { margin: 8px auto; max-width: 420px; text-align: center; transform: rotate(-1.5deg) }
  .lp-bild img { width: 100%; height: auto; border: 3px solid var(--line); border-radius: 10px; background: #fff }
  .lp-bild figcaption { font: 700 1rem var(--display); color: var(--ink-soft); margin-top: 6px }
  .buy { grid-template-columns: repeat(3, minmax(0, 1fr)) }
  .names { margin: 0; padding-left: 1.2em; display: grid; gap: 8px }
  @media (max-width: 980px) { .buy { grid-template-columns: 1fr } }
</style>
